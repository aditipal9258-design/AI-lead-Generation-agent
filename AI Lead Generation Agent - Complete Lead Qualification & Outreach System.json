    {
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "const item = $json;\nconst requiredStrings = [\"lead_name\",\"email\",\"phone\",\"job_title\",\"company\",\"industry\",\n  \"company_size\",\"location\",\"website\",\"pain_point\",\"buying_signal\",\"source\"];\n\nconst clean = {};\nfor (const key of requiredStrings) {\n  let v = item[key];\n  if (v === undefined || v === null || String(v).trim() === \"\") {\n    v = \"Unknown\";\n  } else {\n    v = String(v).trim();\n  }\n  clean[key] = v;\n}\n\nconst emailRegex = /^[^\\s@]+@[^\\s@]+\\.[^\\s@]+$/;\nclean.email_valid = emailRegex.test(clean.email) ? true : false;\nclean.name_valid = clean.lead_name !== \"Unknown\";\nclean.company_valid = clean.company !== \"Unknown\";\nclean.is_valid_lead = clean.email_valid && clean.name_valid && clean.company_valid;\nclean.status = \"New\";\nclean.received_at = new Date().toISOString();\n\nconst base = 15;\nclean.lead_id = \"L\" + String(base + $itemIndex + 1).padStart(3, \"0\");\n\nreturn { json: clean };"
      },
